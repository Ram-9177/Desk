# Copy to .env on the server and fill in. Never commit .env.
NODE_ENV=production
PORT=4300
# Listen only on localhost; nginx is the public entry point.
HOST=127.0.0.1
# Postgres connection: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://onedesk:CHANGE_ME@127.0.0.1:5432/onedesk
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Public address used in email links (the Email page setting overrides it).
PUBLIC_BASE_URL=https://stmarys-desk.supercxo.ai
# The super admin. On a start with both lines set, this account becomes a super admin with this password as a TEMPORARY
# one: the first sign-in must choose a new password. Applied once per email + password; change the line to apply again
# (new super admin, or a forgotten password).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: where uploaded photos are stored (default data/uploads)
# UPLOAD_DIR=data/uploads

# Food feedback reports: the key Power Automate sends as X-Report-Key to /api/reports/food/... (long random value; empty = endpoints off)
FOOD_REPORT_KEY=
# 0 = ONE Desk does not send the 10 PM food reports itself (Power Automate sends them instead)
FOOD_REPORT_AUTOSEND=
