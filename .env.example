# Copy to .env on the server and fill in. Never commit .env.
NODE_ENV=production
PORT=4300
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# Public address used in email links (the Email page setting overrides it).
PUBLIC_BASE_URL=https://desk.supercxo.ai
# Domain Caddy gets the HTTPS certificate for (docker-compose only). Its DNS A record must point at the server.
DOMAIN=desk.supercxo.ai
# Used once, on the first start with an empty database, to create the super admin.
# Remove both lines after the first successful sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: where uploaded photos are stored (default data/uploads)
# UPLOAD_DIR=data/uploads
